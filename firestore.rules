rules_version = '2';

// Reglas de seguridad del Llavero. Cada usuario solo puede leer y escribir lo suyo.
// El contenido ya llega cifrado desde el navegador: el servidor no puede leerlo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function isKey(value) {
        return value is string && value.size() < 200;
      }

      // Clave del llavero: nunca se puede borrar ni sobrescribir de golpe (todo quedaría ilegible).
      // Al cambiar la contraseña maestra se hace en dos pasos:
      //   1) se deja la actual tal cual y se añade la nueva en nextWrappedKey;
      //   2) la nueva pasa a ser wrappedKey, y solo puede ser exactamente la del paso 1.
      // Así, dos dispositivos que crean el llavero a la vez nunca se pisan la clave.
      allow get: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['wrappedKey'])
        && isKey(request.resource.data.wrappedKey);
      allow update: if isOwner()
        && request.resource.data.keys().hasOnly(['wrappedKey', 'nextWrappedKey'])
        && isKey(request.resource.data.wrappedKey)
        && (
          ('nextWrappedKey' in request.resource.data
            && isKey(request.resource.data.nextWrappedKey)
            && request.resource.data.wrappedKey == resource.data.wrappedKey)
          || (!('nextWrappedKey' in request.resource.data)
            && request.resource.data.wrappedKey == resource.data.get('nextWrappedKey', null))
        );

      match /items/{itemId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 100000
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
