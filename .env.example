# Copia este archivo como .env y rellena con la configuración de tu app web de Firebase
# (Firebase console > Configuración del proyecto > General > Tus apps > Configuración del SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=
